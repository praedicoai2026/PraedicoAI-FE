# Set this to enable production indexing.
# NEXT_PUBLIC_SITE_URL should be the verified HTTPS origin of the production site.
NEXT_PUBLIC_SITE_URL=
# Optional public address for mailto fallbacks on the other inquiry forms.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional external portal URLs for the main-site navbar; otherwise same-app routes are used.
NEXT_PUBLIC_ADMIN_PORTAL_URL=
NEXT_PUBLIC_DEMO_PORTAL_URL=

# Server-only portal sign-in credentials. Configure these in deployment secrets.
ADMIN_PORTAL_EMAIL=
ADMIN_PORTAL_PASSWORD=
DEMO_PORTAL_EMAIL=
DEMO_PORTAL_PASSWORD=
# Use a unique random secret of at least 32 characters.
PORTAL_SESSION_SECRET=

# Server-only SMTP settings for /contact form and email OTP delivery.

# Email SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Contact-form email verification code settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Sender account credentials
SMTP_USER=
SMTP_PASSWORD=

# Static sender details
MAIL_FROM=

# Recipient for contact-form notifications
MAIL_TO=
