# Optional canonical URL override. Vercel production defaults to https://praedicoai.com.
NEXT_PUBLIC_SITE_URL=
# Optional public address for mailto fallbacks on the other inquiry forms.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional WhatsApp number in international format, digits only (country code included).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional external portal URLs for the main-site navbar; otherwise same-app routes are used.
NEXT_PUBLIC_ADMIN_PORTAL_URL=
NEXT_PUBLIC_DEMO_PORTAL_URL=

# Server-side destination used by registration, email verification, and lead APIs.
BACKEND_API_URL=http://localhost:4000
# Must match backend AUTH_INTERNAL_SECRET. Used only for server-to-server requests.
AUTH_INTERNAL_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Server-only demo portal credentials. Configure in deployment secrets.
DEMO_PORTAL_EMAIL=
DEMO_PORTAL_PASSWORD=
# Use a unique random secret of at least 32 characters for the demo portal.
PORTAL_SESSION_SECRET=

# Server-only SMTP settings for contact, lead notifications, and email OTP delivery.

# Email SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Sender account credentials
SMTP_USER=
SMTP_PASSWORD=

# Static sender details
MAIL_FROM=

# Recipient for contact-form notifications
MAIL_TO=
