NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Exact browser origins, comma-separated; never use a wildcard for production.
FRONTEND_ORIGINS=https://praedicoai.com,http://localhost:3000
# Backward-compatible single-origin setting; if set, it is added to the allowlist.
# FRONTEND_ORIGIN=http://localhost:3000
DB_USER=praedicoai
DB_PASSWORD=praedicoai_dev
MONGODB_URI=mongodb://localhost:27017/praedicoai
AUTH_INTERNAL_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_SETUP_CONFIRMATION=
# Keep the provider key server-side. The demo release gate defaults to disabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_DEMO_RELEASE_STATUS=coming-soon
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
DEMO_MAX_INPUT_CHARACTERS=2000
DEMO_MAX_OUTPUT_TOKENS=600
